-- Cassandra schema for the Lasair dev stack.
-- candidates and noncandidates are not defined anywhere in the repo; production
-- writes them from the ZTF alert candidate dict (pipeline/ingest/ingest.py).
-- These columns come from tests/unit/pipeline/filter/sample_alerts.
-- forcedphot is copied from forcedphot/forcedphot.cql.

CREATE KEYSPACE IF NOT EXISTS lasair WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};

USE lasair;

CREATE TABLE IF NOT EXISTS candidates(
  objectid ascii,
  aimage double,
  aimagerat double,
  bimage double,
  bimagerat double,
  candid bigint,
  chinr double,
  chipsf double,
  classtar double,
  clrcoeff double,
  clrcounc double,
  clrmed double,
  clrrms double,
  dec double,
  decnr double,
  diffmaglim double,
  distnr double,
  distpsnr1 double,
  distpsnr2 double,
  distpsnr3 double,
  drb double,
  drbversion ascii,
  dsdiff double,
  dsnrms double,
  elong double,
  exptime double,
  fid int,
  field int,
  fwhm double,
  htmid16 bigint,
  isdiffpos ascii,
  jd double,
  jdendhist double,
  jdendref double,
  jdstarthist double,
  jdstartref double,
  magap double,
  magapbig double,
  magdiff double,
  magfromlim double,
  maggaia double,
  maggaiabright double,
  magnr double,
  magpsf double,
  magzpsci double,
  magzpscirms double,
  magzpsciunc double,
  mindtoedge double,
  nbad int,
  ncovhist int,
  ndethist int,
  neargaia double,
  neargaiabright double,
  nframesref int,
  nid int,
  nmatches int,
  nmtchps int,
  nneg int,
  objectidps1 bigint,
  objectidps2 bigint,
  objectidps3 bigint,
  pdiffimfilename ascii,
  pid bigint,
  programid int,
  programpi ascii,
  ra double,
  ranr double,
  rb double,
  rbversion ascii,
  rcid int,
  rfid bigint,
  scorr double,
  seeratio double,
  sgmag1 double,
  sgmag2 double,
  sgmag3 double,
  sgscore1 double,
  sgscore2 double,
  sgscore3 double,
  sharpnr double,
  sigmagap double,
  sigmagapbig double,
  sigmagnr double,
  sigmapsf double,
  simag1 double,
  simag2 double,
  simag3 double,
  sky double,
  srmag1 double,
  srmag2 double,
  srmag3 double,
  ssdistnr double,
  ssmagnr double,
  ssnamenr ascii,
  ssnrms double,
  sumrat double,
  szmag1 double,
  szmag2 double,
  szmag3 double,
  tblid int,
  tooflag int,
  xpos double,
  ypos double,
  zpclrcov double,
  zpmed double,
  PRIMARY KEY (objectid, candid)
);

CREATE TABLE IF NOT EXISTS noncandidates(
  objectid ascii,
  jd double,
  fid int,
  diffmaglim double,
  nid int,
  field int,
  magzpsci double,
  magzpsciunc double,
  magzpscirms double,
  PRIMARY KEY (objectid, jd)
);

CREATE TABLE IF NOT EXISTS forcedphot(
  objectid ascii,
  field int,
  rcid int,
  fid int,
  pid bigint,
  rfid bigint,
  sciinpseeing float,
  scibckgnd float,
  scisigpix float,
  magzpsci float,
  magzpsciunc float,
  magzpscirms float,
  clrcoeff float,
  clrcounc float,
  exptime float,
  adpctdif1 float,
  adpctdif2 float,
  diffmaglim float,
  programid int,
  jd double,
  forcediffimflux float,
  forcediffimfluxunc float,
  procstatus ascii,
  distnr float,
  ranr double,
  decnr double,
  magnr float,
  sigmagnr float,
  chinr float,
  sharpnr float,
  PRIMARY KEY (objectid, jd)
);
